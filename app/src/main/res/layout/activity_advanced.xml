<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="com.alcanl.cleverear.viewmodel.AdvancedActivityViewModel"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <variable name="viewModel" type="AdvancedActivityViewModel" />
        <variable name="config" type="ConfigurationModule" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/design_default_color_secondary_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout3"
        app:menu="@menu/bottom_nav_menu">

    </com.google.android.material.bottomnavigation.BottomNavigationView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="75dp"
            android:layout_height="70dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/main_logo_description_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/eartechnic_logo" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutMode"
            android:layout_width="0dp"
            android:layout_height="140dp"

            app:layout_constraintBottom_toTopOf="@+id/constraintLayout6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textViewMode"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_mode_text"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewChannel"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_channel_text"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewMode" />

            <Button
                android:id="@+id/buttonModeOne"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/default_button_color"
                android:fontFamily="sans-serif-medium"
                android:onClick="@{(v)-> viewModel.handleModeButtons(v)}"
                android:text="@string/button_text_one"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:cornerRadius="0dp"
                app:layout_constraintStart_toEndOf="@+id/textViewMode"
                app:layout_constraintTop_toTopOf="parent" />

            <Button

                android:id="@+id/buttonModeTwo"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_marginStart="3dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/default_button_color"
                android:fontFamily="sans-serif-medium"
                android:onClick="@{(v)-> viewModel.handleModeButtons(v)}"
                android:text="@string/button_text_two"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:cornerRadius="0dp"
                app:layout_constraintStart_toEndOf="@+id/buttonModeOne"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/buttonModeThree"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_marginStart="3dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/default_button_color"
                android:fontFamily="sans-serif-medium"
                android:onClick="@{(v)-> viewModel.handleModeButtons(v)}"
                android:text="@string/button_text_three"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:cornerRadius="0dp"
                app:layout_constraintStart_toEndOf="@+id/buttonModeTwo"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/editTextChannel"
                android:layout_width="155dp"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="80dp"
                android:autofillHints=""
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/edittext_channel_hint"
                android:inputType="number"
                android:textAlignment="center"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@+id/textViewChannel"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="70dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/button_check_tick_content_desc"
                android:onClick="@{(v)-> viewModel.handleSetChannelButtonClick(v)}"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toEndOf="@+id/editTextChannel"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/check_tick" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout6"
            android:layout_width="0dp"
            android:layout_height="190dp"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayoutMode">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAuxCommon"
                android:layout_width="190dp"
                android:layout_height="59dp"
                android:rotation="270"
                android:value="@{config.INSTANCE.doubleDeviceConnection ? config.doubleDeviceMap.get(EarSide.Left).component14() : config.INSTANCE.hearingAid.component14()}"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:visibility="visible"
                android:contentDescription="@string/aux_common_slider_desc"
                app:haloColor="@color/design_default_color_secondary_variant"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.497"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewAux"
                app:onValueChangeListener="@{(value) -> viewModel.handleAuxDualSliderValueChange(value)}"
                app:thumbColor="@color/design_default_color_secondary_variant"
                app:thumbRadius="16dp"
                app:trackColorActive="@color/design_default_color_secondary_variant"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAuxRight"
                android:layout_width="180dp"
                android:layout_height="59dp"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                android:rotation="270"
                android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.doubleDeviceMap.get(EarSide.Right).component14() : config.INSTANCE.hearingAid.component14()}"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:visibility="visible"
                android:contentDescription="@string/aux_right_slider_desc"
                app:haloColor="@color/right_device_slider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:onValueChangeListener="@{(value) -> viewModel.handleAuxRightSliderValueChange(value)}"
                app:thumbColor="@color/right_device_slider"
                app:thumbRadius="16dp"
                app:trackColorActive="@color/right_device_slider"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAuxLeft"
                android:layout_width="180dp"
                android:layout_height="59dp"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                android:rotation="270"
                android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.doubleDeviceMap.get(EarSide.Left).component14() : config.INSTANCE.hearingAid.component14()}"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:visibility="visible"
                android:contentDescription="@string/aux_left_slider_desc"
                app:haloColor="@color/left_device_slider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:onValueChangeListener="@{(value) -> viewModel.handleAuxLeftSliderValueChange(value)}"
                app:thumbColor="@color/left_device_slider"
                app:thumbRadius="16dp"
                app:trackColorActive="@color/left_device_slider"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp" />

            <TextView
                android:id="@+id/textViewAuxL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="57dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_L_text"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewAuxR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="57dp"
                android:layout_marginEnd="32dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_R_text"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewAux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_aux_label"
                android:textAlignment="center"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout5"
            android:layout_width="0dp"
            android:layout_height="190dp"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout6">

            <TextView
                android:id="@+id/textViewMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_mic_label"
                android:textAlignment="center"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewMicR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="57dp"
                android:layout_marginEnd="32dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_R_text"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewMicL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="57dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_L_text"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMicLeft"
                android:layout_width="180dp"
                android:layout_height="59dp"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                android:rotation="270"
                android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.doubleDeviceMap.get(EarSide.Left).component15() : config.INSTANCE.hearingAid.component15()}"
                android:valueFrom="8.0"
                android:valueTo="88.0"
                android:visibility="visible"
                android:contentDescription="@string/mic_left_slider_desc"
                app:haloColor="@color/left_device_slider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:onValueChangeListener="@{(value) -> viewModel.handleMicLeftSliderValueChange(value)}"
                app:thumbColor="@color/left_device_slider"
                app:thumbRadius="16dp"
                app:trackColorActive="@color/left_device_slider"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMicCommon"
                android:layout_width="190dp"
                android:layout_height="59dp"
                android:rotation="270"
                android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.doubleDeviceMap.get(EarSide.Left).component15() : config.INSTANCE.hearingAid.component15()}"
                android:valueFrom="8.0"
                android:valueTo="88.0"
                android:visibility="visible"
                android:contentDescription="@string/mic_common_slider_desc"
                app:haloColor="@color/design_default_color_secondary_variant"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/sliderMicRight"
                app:layout_constraintHorizontal_bias="0.497"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewMic"
                app:onValueChangeListener="@{(value) -> viewModel.handleMicDualSliderValueChange(value)}"
                app:thumbColor="@color/design_default_color_secondary_variant"
                app:thumbRadius="16dp"
                app:trackColorActive="@color/design_default_color_secondary_variant"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMicRight"
                android:layout_width="180dp"
                android:layout_height="59dp"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                android:rotation="270"
                android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.doubleDeviceMap.get(EarSide.Right).component15() : config.INSTANCE.hearingAid.component15()}"
                android:valueFrom="8.0"
                android:valueTo="88.0"
                android:visibility="visible"
                android:contentDescription="@string/mic_right_slider_desc"
                app:haloColor="@color/right_device_slider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:onValueChangeListener="@{(value) -> viewModel.handleMicRightSliderValueChange(value)}"
                app:thumbColor="@color/right_device_slider"
                app:thumbRadius="16dp"
                app:trackColorActive="@color/right_device_slider"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout4"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout5">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDual"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_gravity="top"
                android:checked="@={config.INSTANCE.dualDeviceConfig}"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection}"
                android:fontFamily="sans-serif-medium"
                android:onCheckedChanged="@{()-> viewModel.handleSwitchCheckedChange()}"
                android:text="@string/switch_dual_device_text"
                android:textColor="@color/ap_black"
                android:textSize="12sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@drawable/switch_theme" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
