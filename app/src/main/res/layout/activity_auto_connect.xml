<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <import type="com.alcanl.cleverear.viewmodel.AutoConnectActivityListenersViewModel"/>
        <variable name="viewModel" type="AutoConnectActivityListenersViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <TextView
            android:id="@+id/textViewRemoteConf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:text="@string/textview_remote_conf_ha"
            android:visibility="gone"
            android:textColor="@color/ap_black"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageButtonRemoteConf" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="328dp"
            android:layout_height="180dp"
            android:layout_marginStart="41dp"
            android:layout_marginEnd="41dp"
            android:contentDescription="@string/main_logo_description_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.127"
            app:srcCompat="@drawable/cleverear_logo"
            tools:ignore="ImageContrastCheck" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:layout_marginTop="15dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView2">

            <FrameLayout
                android:id="@+id/frameLayoutLeftEar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="5">

                <com.daasuu.bl.BubbleLayout
                    android:id="@+id/bubbleLayoutLeftEar"
                    android:layout_width="111dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:padding="8dp"
                    android:visibility="invisible"
                    app:bl_arrowDirection="bottom_right"
                    app:bl_arrowHeight="8dp"
                    app:bl_arrowPosition="16dp"
                    app:bl_arrowWidth="8dp"
                    app:bl_cornersRadius="6dp"
                    app:bl_strokeWidth="1dp"
                    tools:ignore="TextSizeCheck">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="4dp"
                        android:text="@string/device_already_connected_text"
                        android:textAlignment="center"
                        android:textColor="@color/left_device_slider"
                        android:textSize="14sp"
                        tools:ignore="SmallSp,TextContrastCheck" />

                </com.daasuu.bl.BubbleLayout>

                <ImageButton
                    android:id="@+id/imageButtonLeft"
                    android:layout_width="119dp"
                    android:layout_height="151dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#00FFFFFF"
                    android:contentDescription="@string/textview_left_device_text"
                    android:onClick="@{()-> viewModel.handleLeftEarButtonClick()}"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/lefteargray" />

                <TextView
                    android:id="@+id/textViewLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="90dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@{viewModel.leftEarModelNumber}"
                    android:textColor="@color/left_device_slider"
                    android:textSize="16sp" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutRightEar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="5">

                <com.daasuu.bl.BubbleLayout
                    android:id="@+id/bubbleLayoutRightEar"
                    android:layout_width="111dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="12dp"
                    android:padding="8dp"
                    android:visibility="invisible"
                    app:bl_arrowDirection="bottom"
                    app:bl_arrowHeight="8dp"
                    app:bl_arrowPosition="16dp"
                    app:bl_arrowWidth="8dp"
                    app:bl_cornersRadius="6dp"
                    app:bl_strokeWidth="1dp"
                    tools:ignore="TextSizeCheck">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="4dp"
                        android:text="@string/device_already_connected_text"
                        android:textAlignment="center"
                        android:textColor="@color/right_device_slider"
                        android:textSize="14sp"
                        tools:ignore="SmallSp,TextContrastCheck" />

                </com.daasuu.bl.BubbleLayout>

                <ImageButton
                    android:id="@+id/imageButtonRight"
                    android:layout_width="119dp"
                    android:layout_height="151dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#00FFFFFF"
                    android:contentDescription="@string/textview_right_device_text"
                    android:onClick="@{() -> viewModel.handleRightEarButtonClick()}"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/righteargray" />

                <TextView
                    android:id="@+id/textViewRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="90dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@{viewModel.rightEarModelNumber}"
                    android:textColor="@color/right_device_slider"
                    android:textSize="16sp" />
            </FrameLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/imageButtonControl"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:backgroundTint="#00FFFFFF"
            android:contentDescription="@string/textview_control_ha"
            android:foregroundTint="#FFFFFF"
            android:onClick="@{()-> viewModel.handleControlButtonClick()}"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            app:layout_constraintVertical_bias="0.084"
            app:srcCompat="@drawable/baseline_bluetooth_audio_24"
            tools:ignore="DuplicateSpeakableTextCheck" />

        <TextView
            android:id="@+id/textViewControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:text="@string/textview_connect_to_selected_device_text"
            android:textColor="#0020FD"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageButtonControl" />

        <ImageButton
            android:id="@+id/imageButtonRemoteConf"
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:backgroundTint="#00FFFFFF"
            android:visibility="gone"
            android:onClick="@{()->viewModel.handleRemoteFittingButtonClick()}"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewControl"
            app:layout_constraintVertical_bias="0.301"
            app:srcCompat="@drawable/baseline_rss_feed_24"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>