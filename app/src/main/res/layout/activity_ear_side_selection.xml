<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <import type="com.alcanl.cleverear.viewmodel.EarSideSelectionActivityListenersViewModel"/>
        <variable
            name="viewModel"
            type="EarSideSelectionActivityListenersViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="328dp"
            android:layout_height="180dp"
            android:layout_marginStart="41dp"
            android:layout_marginEnd="41dp"
            android:contentDescription="@string/main_logo_description_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.127"
            app:srcCompat="@drawable/cleverear_logo"
            tools:ignore="ImageContrastCheck" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="414dp"
            android:layout_height="350dp"
            android:layout_marginTop="33dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView2"
            android:baselineAligned="false"
            tools:ignore="VisualLintBounds">

            <FrameLayout
                android:id="@+id/frameLayoutLeftEar"
                android:layout_width="match_parent"
                android:layout_height="323dp"
                android:layout_weight="5">

                <ImageButton
                    android:layout_width="119dp"
                    android:layout_height="151dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:background="#00FFFFFF"
                    android:contentDescription="@string/textview_left_device_text"
                    android:onClick="@{()-> viewModel.handleLeftEarButton()}"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/leftear_blue"
                    tools:ignore="DuplicateSpeakableTextCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="110dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/left_ear_side_text"
                    android:textColor="@color/ap_black"
                    android:textSize="20sp" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutRightEar"
                android:layout_width="match_parent"
                android:layout_height="323dp"
                android:layout_weight="5">

                <ImageButton
                    android:layout_width="119dp"
                    android:layout_height="151dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10dp"
                    android:background="#00FFFFFF"
                    android:contentDescription="@string/textview_right_device_text"
                    android:onClick="@{() -> viewModel.handleRightEarButton()}"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/rightear_red"
                    tools:ignore="DuplicateSpeakableTextCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="110dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/right_ear_side_text"
                    android:textColor="@color/ap_black"
                    android:textSize="20sp" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>