<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.alcanl.cleverear.viewmodel.ControlActivityListenersViewModel"/>
        <import type="com.alcanl.cleverear.helpers.EarSide"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <variable name="viewModel" type="ControlActivityListenersViewModel" />
        <variable name="config" type="ConfigurationModule" />
    </data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ControlActivity"
    android:background="@drawable/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tableLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCommon"
                android:layout_width="316dp"
                android:layout_height="73dp"
                android:layout_marginTop="132dp"
                android:layout_marginBottom="123dp"
                android:rotation="270"
                android:value="20.0"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/textViewRightSeekBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewVolume"
                app:layout_constraintVertical_bias="0.0"
                app:onValueChangeListener="@{(value) -> viewModel.handleDualSliderValueChange(value)}"
                app:thumbColor="@color/design_default_color_secondary_variant"
                app:thumbRadius="16dp"
                app:haloColor="@color/design_default_color_secondary_variant"
                app:trackColorInactive="#A8A3A3"
                app:trackColorActive="@color/design_default_color_secondary_variant"
                app:trackHeight="12dp" />

            <FrameLayout
                android:id="@+id/frameLayoutBatteryRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.wisal.android.views.batteryview.BatteryView
                    android:id="@+id/batteryViewRightDevice"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:visibility="invisible"
                    app:battery_level="100"
                    app:charging="false"
                    app:outer_border_color="@android:color/darker_gray"
                    app:outer_border_stroke_width="2dp"
                    app:warning_level="15" />
            </FrameLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDualConfiguration"
                android:layout_width="159dp"
                android:layout_height="61dp"
                android:layout_marginStart="148dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="148dp"
                android:layout_marginBottom="8dp"
                android:visibility="invisible"
                android:checked="@={config.INSTANCE.dualDeviceConfig}"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection}"
                android:fontFamily="sans-serif-medium"
                android:onCheckedChanged="@{()-> viewModel.handleSwitchCheckedChange()}"
                android:text="@string/switch_dual_device_text"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@+id/textViewPrograms"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewRightSeekBar"
                app:thumbTint="@drawable/switch_theme" />

            <TextView
                android:id="@+id/textViewRightSeekBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="123dp"
                android:layout_marginEnd="77dp"
                android:visibility="invisible"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_right_device_text"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderRight" />

            <TextView
                android:id="@+id/textViewLeftSeekBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:layout_marginTop="123dp"
                android:fontFamily="sans-serif-medium"
                android:visibility="invisible"
                android:text="@string/textview_left_device_text"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderLeft" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderLeft"
                android:layout_width="292dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="-30dp"
                android:layout_marginTop="130dp"
                android:layout_marginBottom="123dp"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : config.INSTANCE.hearingAid.component5() == EarSide.Left}"
                android:rotation="270"
                android:value="20.0"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:visibility="invisible"
                app:trackColorInactive="#A8A3A3"
                app:trackColorActive="@color/left_device_slider"
                app:haloColor="@color/left_device_slider"
                app:layout_constraintBottom_toTopOf="@+id/textViewRightSeekBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewVolume"
                app:layout_constraintVertical_bias="0.0"
                app:onValueChangeListener="@{(value) -> viewModel.handleLeftEarSliderValueChange(value)}"
                app:thumbColor="@color/left_device_slider"
                app:thumbRadius="16dp"
                app:trackHeight="12dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRight"
                android:layout_width="292dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="130dp"
                android:layout_marginEnd="-30dp"
                android:layout_marginBottom="123dp"
                android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : config.INSTANCE.hearingAid.component5() == EarSide.Right}"
                android:rotation="270"
                android:value="20.0"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:visibility="invisible"
                app:trackColorInactive="#A8A3A3"
                app:trackColorActive="@color/right_device_slider"
                app:haloColor="@color/right_device_slider"
                app:layout_constraintBottom_toTopOf="@+id/textViewRightSeekBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewVolume"
                app:onValueChangeListener="@{(value) -> viewModel.handleRightEarSliderValueChange(value)}"
                app:thumbColor="@color/right_device_slider"
                app:thumbRadius="16dp"
                app:trackHeight="12dp" />

            <TextView
                android:id="@+id/textViewPrograms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="144dp"
                android:layout_marginEnd="144dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_program_text"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="22sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_volume_text"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/frameLayoutBatteryLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.wisal.android.views.batteryview.BatteryView
                    android:id="@+id/batteryViewLeftDevice"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:visibility="invisible"
                    app:battery_level="100"
                    app:charging="false"
                    app:outer_border_color="@android:color/darker_gray"
                    app:outer_border_stroke_width="2dp"
                    app:warning_level="15" />

            </FrameLayout>

            <TextView
                android:id="@+id/textViewCommon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="150dp"
                android:layout_marginBottom="15dp"
                android:text="@string/empty_string"
                android:textColor="@color/black"
                app:layout_constraintBottom_toTopOf="@+id/switchDualConfiguration"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderCommon"
                app:layout_constraintVertical_bias="0.765" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="87dp"
            android:layout_height="90dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/main_logo_description_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/cleverear_logo_opacity" />

        <TableLayout
            android:id="@+id/tableLayout"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="35dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/table_layout_border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout2">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <Button
                    android:id="@+id/buttonOne"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(0, v)}"
                    android:text="@string/button_text_one"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />

                <Button
                    android:id="@+id/buttonTwo"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(1, v)}"
                    android:text="@string/button_text_two"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />

                <Button
                    android:id="@+id/buttonThree"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(2, v)}"
                    android:text="@string/button_text_three"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />

                <Button
                    android:id="@+id/buttonFour"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(3, v)}"
                    android:text="@string/button_text_four"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <Button
                    android:id="@+id/buttonFive"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(4, v)}"
                    android:text="@string/button_text_five"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />

                <Button
                    android:id="@+id/buttonSix"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(5, v)}"
                    android:text="@string/button_text_six"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />

                <Button
                    android:id="@+id/buttonSeven"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(6, v)}"
                    android:text="@string/button_text_seven"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />

                <Button
                    android:id="@+id/buttonEight"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(7, v)}"
                    android:text="@string/button_text_eight"
                    android:textColor="@color/ap_black"
                    android:textSize="24sp"
                    app:cornerRadius="50dp" />
            </TableRow>


        </TableLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/design_default_color_secondary_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
        app:menu="@menu/bottom_nav_menu" />


</androidx.constraintlayout.widget.ConstraintLayout>
</layout>