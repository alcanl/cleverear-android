<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:android="http://schemas.android.com/apk/res/android">

<data>
    <import type="com.alcanl.cleverear.viewmodel.ControlFragmentListenersViewModel"/>
    <import type="com.alcanl.cleverear.util.EarSide"/>
    <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
    <import type="android.view.View"/>
    <import type="androidx.core.content.ContextCompat"/>
    <import type="android.content.Context"/>
    <import type="com.alcanl.cleverear.R"/>
    <variable name="viewModel" type="com.alcanl.cleverear.viewmodel.ControlFragmentListenersViewModel" />
    <variable name="config" type="ConfigurationModule" />
</data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.ControlFragment"
    android:background="@drawable/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ir.programmerplus.groupbox.GroupBoxLayout
            android:id="@+id/groupBoxLayoutVolumeAndBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:padding="5dp"
            app:borderColor="#128ba6"
            app:labelText="@string/textview_volume_text"
            app:labelTextColor="#128ba6"
            app:labelTextSize="22sp"
            app:layout_constraintBottom_toTopOf="@+id/groupBoxLayoutPrograms"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewDescription">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                tools:layout_editor_absoluteX="141dp"
                tools:layout_editor_absoluteY="162dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderCommon"
                    android:layout_width="280dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="128dp"
                    android:contentDescription="@string/volume_common_slider_desc"
                    android:rotation="270"
                    android:value="45"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.dualDeviceConfig ? View.VISIBLE : View.INVISIBLE : View.VISIBLE}"
                    app:haloColor="@{config.INSTANCE.doubleDeviceConnection ? ContextCompat.getColor(context, R.color.design_default_color_secondary_variant) : config.INSTANCE.earSide.equals(EarSide.Left) ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                    app:layout_constraintBottom_toTopOf="@+id/switchDualConfiguration"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:onValueChangeListener="@{(value) -> viewModel.handleDualSliderValueChange(value)}"
                    app:thumbColor="@{config.INSTANCE.doubleDeviceConnection ? ContextCompat.getColor(context, R.color.design_default_color_secondary_variant) : config.INSTANCE.earSide.equals(EarSide.Left) ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                    app:thumbRadius="16dp"
                    app:trackColorActive="@{config.INSTANCE.doubleDeviceConnection ? ContextCompat.getColor(context, R.color.design_default_color_secondary_variant) : config.INSTANCE.earSide.equals(EarSide.Left) ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                    app:trackColorInactive="#A8A3A3"
                    app:trackHeight="12dp" />

                <FrameLayout
                    android:id="@+id/frameLayoutBatteryRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="100dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.wisal.android.views.batteryview.BatteryView
                        android:id="@+id/batteryViewRightDevice"
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:visibility="@{config.INSTANCE.doubleDeviceConnection ? View.VISIBLE : config.INSTANCE.earSide.equals(EarSide.Right) ? View.VISIBLE : View.INVISIBLE}"
                        app:battery_level="100"
                        app:charging="false"
                        app:outer_border_color="@android:color/darker_gray"
                        app:outer_border_stroke_width="2dp"
                        app:warning_level="15" />
                </FrameLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDualConfiguration"
                    android:layout_width="155dp"
                    android:layout_height="35dp"
                    android:checked="@={config.INSTANCE.dualDeviceConfig}"
                    android:enabled="@{config.INSTANCE.doubleDeviceConnection}"
                    android:fontFamily="sans-serif-medium"
                    android:onCheckedChanged="@{()-> viewModel.handleSwitchCheckedChange()}"
                    android:text="@string/switch_dual_device_text"
                    android:textAlignment="center"
                    android:textColor="@color/ap_black"
                    android:textSize="12sp"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? View.VISIBLE : View.INVISIBLE}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color"
                    tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/textViewRightSeekBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="85dp"
                    android:layout_marginEnd="50dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/textview_right_device_text"
                    android:textColor="@color/black"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.dualDeviceConfig ? View.INVISIBLE : View.VISIBLE : View.INVISIBLE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sliderRight"
                    tools:ignore="VisualLintLocaleText" />

                <TextView
                    android:id="@+id/textViewLeftSeekBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="85dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/textview_left_device_text"
                    android:textColor="@color/black"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.dualDeviceConfig ? View.INVISIBLE : View.VISIBLE : View.INVISIBLE}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sliderLeft"
                    tools:ignore="VisualLintLocaleText" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderLeft"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-35dp"
                    android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                    android:rotation="270"
                    android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Left).component8() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component8()}"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.dualDeviceConfig ? View.INVISIBLE : View.VISIBLE : View.INVISIBLE}"
                    app:haloColor="@color/left_device_slider"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:onValueChangeListener="@{(value) -> viewModel.handleLeftEarSliderValueChange(value)}"
                    app:thumbColor="@color/left_device_slider"
                    app:thumbRadius="16dp"
                    app:trackColorActive="@color/left_device_slider"
                    app:trackColorInactive="#A8A3A3"
                    app:trackHeight="12dp"
                    tools:ignore="VisualLintBounds,SpeakableTextPresentCheck" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRight"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-35dp"
                    android:enabled="@{config.INSTANCE.doubleDeviceConnection}"
                    android:rotation="270"
                    android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Right).component8() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component8()}"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.dualDeviceConfig ? View.INVISIBLE : View.VISIBLE : View.INVISIBLE}"
                    app:haloColor="@color/right_device_slider"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:onValueChangeListener="@{(value) -> viewModel.handleRightEarSliderValueChange(value)}"
                    app:thumbColor="@color/right_device_slider"
                    app:thumbRadius="16dp"
                    app:trackColorActive="@color/right_device_slider"
                    app:trackColorInactive="#A8A3A3"
                    app:trackHeight="12dp"
                    tools:ignore="VisualLintBounds,SpeakableTextPresentCheck" />

                <FrameLayout
                    android:id="@+id/frameLayoutBatteryLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="100dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.wisal.android.views.batteryview.BatteryView
                        android:id="@+id/batteryViewLeftDevice"
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:visibility="@{config.INSTANCE.doubleDeviceConnection ? View.VISIBLE : config.INSTANCE.earSide.equals(EarSide.Left) ? View.VISIBLE : View.INVISIBLE}"
                        app:battery_level="100"
                        app:charging="false"
                        app:outer_border_color="@android:color/darker_gray"
                        app:outer_border_stroke_width="2dp"
                        app:warning_level="15" />

                </FrameLayout>

                <TextView
                    android:id="@+id/textViewCommon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="105dp"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? View.INVISIBLE : View.VISIBLE}"
                    android:text="@{config.INSTANCE.doubleDeviceConnection ? context.getString(R.string.empty_string) : config.INSTANCE.earSide.equals(EarSide.Left) ? context.getString(R.string.textview_left_device_text) : context.getString(R.string.textview_right_device_text)}"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sliderCommon" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </ir.programmerplus.groupbox.GroupBoxLayout>

        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/main_logo_description_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/eartechnic_logo" />

        <ir.programmerplus.groupbox.GroupBoxLayout
            android:id="@+id/groupBoxLayoutPrograms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="10dp"
            android:padding="5dp"
            app:borderColor="#128ba6"
            app:labelText="@string/textview_program_text"
            app:labelTextColor="#128ba6"
            app:labelTextSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupBoxLayoutVolumeAndBattery">

            <TableLayout
                android:id="@+id/tableLayout"
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:layout_editor_absoluteY="541dp">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonOne"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(0, v)}"
                        android:text="@string/button_text_one"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonTwo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(1, v)}"
                        android:text="@string/button_text_two"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonThree"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(2, v)}"
                        android:text="@string/button_text_three"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFour"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(3, v)}"
                        android:text="@string/button_text_four"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFive"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(4, v)}"
                        android:text="@string/button_text_five"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSix"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(5, v)}"
                        android:text="@string/button_text_six"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSeven"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(6, v)}"
                        android:text="@string/button_text_seven"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonEight"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/default_button_color"
                        android:onClick="@{(v)-> viewModel.handleMemoryButtonClick(7, v)}"
                        android:text="@string/button_text_eight"
                        android:textColor="@color/ap_black"
                        android:textSize="20sp"
                        android:visibility="invisible"
                        app:cornerRadius="0dp"
                        tools:ignore="VisualLintButtonSize" />
                </TableRow>
            </TableLayout>
        </ir.programmerplus.groupbox.GroupBoxLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewDescription"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="25dp"
            android:text="@string/textview_control_description_text"
            android:textAlignment="center"
            android:textColor="#128ba6"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/imageViewLogo"
            app:layout_constraintHorizontal_bias="0.226"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp,TextContrastCheck,TextSizeCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
</layout>