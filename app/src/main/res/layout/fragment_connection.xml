<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:ignore="VisualLintBounds">
    <data>
        <import type="com.alcanl.cleverear.viewmodel.ConnectionFragmentListenersViewModel"/>
        <import type="android.widget.ArrayAdapter"/>
        <import type="com.alcanl.cleverear.entity.DiscoveredDeviceInfo"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <import type="android.view.View"/>
        <import type="com.alcanl.cleverear.R"/>
        <import type="android.content.Context"/>
        <import type="androidx.appcompat.content.res.AppCompatResources"/>
        <variable name="config" type="ConfigurationModule" />
        <variable name="viewModel" type="com.alcanl.cleverear.viewmodel.ConnectionFragmentListenersViewModel" />
        <variable name="adapter" type="ArrayAdapter&lt;String&gt;" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <TextView
                android:id="@+id/textViewDeviceStateSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/textview_device_detection_not_found_text"
                android:textColor="#121111"
                android:textSize="20sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@+id/textViewDeviceState"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="54dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/button_previous_activity"
                android:onClick="@{()->viewModel.handleBackButton()}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/baseline_arrow_back_24" />

            <ImageView
                android:layout_width="87dp"
                android:layout_height="90dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="9dp"
                android:contentDescription="@string/main_logo_description_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/eartechnic_logo" />

            <FrameLayout
                android:id="@+id/frameLayoutStartScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/table_layout_border"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.197">

                <ImageButton
                    android:id="@+id/imageButtonDetect"
                    android:layout_width="140dp"
                    android:layout_height="177dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#00FFFFFF"
                    android:contentDescription="@string/textview_detect_device_text"
                    android:onClick="@{()->viewModel.handleDetectDeviceButton()}"
                    android:scaleType="fitCenter"
                    app:srcCompat="@{config.INSTANCE.connected ? AppCompatResources.getDrawable(context, R.drawable.baseline_bluetooth_connected_24) : AppCompatResources.getDrawable(context, R.drawable.transparentbluetooth_2)}"
                    tools:ignore="DuplicateSpeakableTextCheck" />

                <TextView
                    android:id="@+id/textViewScanProcess"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="70dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/textview_detect_device_text"
                    android:textColor="@color/ap_black"
                    android:textSize="20sp" />
            </FrameLayout>

            <ir.programmerplus.groupbox.GroupBoxLayout
                android:id="@+id/groupBoxLayoutDeviceList"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="50dp"
                android:visibility="invisible"
                app:borderColor="#A8A3A3"
                app:borderCornerRadius="8dp"
                app:borderStrokeWidth="2.2dp"
                app:labelText="@string/groupbox_select_device_text"
                app:labelTextColor="@color/ap_black"
                app:labelTextSize="10dp"
                app:layout_constraintBottom_toTopOf="@+id/textViewDeviceStateSecond"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayoutEndConnection">

                <ListView
                    android:id="@+id/listView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:adapter="@{adapter}"
                    android:foregroundGravity="center"
                    android:onItemClick="@{(p, v, pos, i)-> viewModel.handleListViewItemSelected(pos)}"
                    android:textAlignment="center" />
            </ir.programmerplus.groupbox.GroupBoxLayout>

            <TextView
                android:id="@+id/textViewDeviceState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/textview_device_detection_not_found_text"
                android:textColor="#121111"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <FrameLayout
                android:id="@+id/frameLayoutEndConnection"
                android:layout_width="289dp"
                android:layout_height="83dp"
                android:layout_marginTop="20dp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayoutStartScan"
                app:layout_constraintVertical_bias="0.0">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonStopConnection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginVertical="5dp"
                    android:backgroundTint="@color/design_default_color_secondary_variant"
                    android:enabled="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:visibility="@{config.INSTANCE.connected ? View.VISIBLE : View.INVISIBLE}"
                    android:onClick="@{()-> viewModel.handleStopConnectionButton()}"
                    android:text="@string/button_stop_connection_text"
                    android:textColor="@color/ap_black"
                    android:textSize="18sp"
                    app:cornerRadius="25dp"
                    app:iconTint="#0E0E0E"
                    app:strokeColor="#00695C" />

                <ImageView
                    android:id="@+id/imageViewStopConnection"
                    android:layout_width="57dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/app_name"
                    android:textColor="@color/ap_black"
                    app:srcCompat="@drawable/img" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/design_default_color_secondary_variant"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutStopConnection"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FFFFFF"
                android:backgroundTint="#D7EEEEEE"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ProgressBar
                    android:id="@+id/progressBarStopConnection"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="66dp"
                    android:layout_height="67dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/design_default_color_secondary_variant" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>