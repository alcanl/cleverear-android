<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:ignore="VisualLintBounds">
    <data>
        <import type="com.alcanl.cleverear.viewmodel.ConnectionFragmentListenersViewModel"/>
        <import type="android.widget.ArrayAdapter"/>
        <import type="com.alcanl.cleverear.entity.DiscoveredDeviceInfo"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <import type="android.view.View"/>
        <import type="com.alcanl.cleverear.R"/>
        <import type="android.content.Context"/>
        <import type="androidx.appcompat.content.res.AppCompatResources"/>
        <variable name="config" type="ConfigurationModule" />
        <variable name="viewModel" type="com.alcanl.cleverear.viewmodel.ConnectionFragmentListenersViewModel" />
        <variable name="adapter" type="ArrayAdapter&lt;String&gt;" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <TextView
                android:id="@+id/textViewDeviceStateSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/textview_device_detection_not_found_text"
                android:textColor="#121111"
                android:textSize="20sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@+id/textViewDeviceState"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="54dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="@string/button_previous_activity"
                android:onClick="@{()->viewModel.handleBackButton()}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/baseline_arrow_back_24" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="9dp"
                android:contentDescription="@string/main_logo_description_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/eartechnic_logo" />

            <ir.programmerplus.groupbox.GroupBoxLayout
                android:id="@+id/groupBoxLayoutScan"
                android:layout_width="270dp"
                android:layout_height="270dp"
                android:layout_marginTop="20dp"
                app:borderColor="@color/light_blue_900"
                app:borderCornerRadius="150dp"
                app:borderStrokeWidth="2.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewDeviceScan">

                <pl.bclogic.pulsator4droid.library.PulsatorLayout
                    android:id="@+id/pulseLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.19"
                    app:pulse_color="@color/light_blue_900"
                    app:pulse_count="6"
                    app:pulse_duration="3000"
                    app:pulse_interpolator="Accelerate"
                    app:pulse_repeat="0"
                    app:pulse_startFromScratch="true">

                    <ImageButton
                        android:id="@+id/imageButtonDetect"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:backgroundTint="#00FFFFFF"
                        android:contentDescription="@string/textview_detect_device_text"
                        android:onClick="@{()->viewModel.handleDetectDeviceButton()}"
                        android:scaleType="fitCenter"
                        app:srcCompat="@{config.INSTANCE.connected ? AppCompatResources.getDrawable(context, R.drawable.bluetooth_connected) : AppCompatResources.getDrawable(context, R.drawable.bluetooth_not_connected)}"
                        tools:ignore="DuplicateSpeakableTextCheck,ImageContrastCheck" />

                </pl.bclogic.pulsator4droid.library.PulsatorLayout>

            </ir.programmerplus.groupbox.GroupBoxLayout>

            <ir.programmerplus.groupbox.GroupBoxLayout
                android:id="@+id/groupBoxLayoutDeviceList"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="50dp"
                android:visibility="invisible"
                app:borderColor="#128ba6"
                app:borderCornerRadius="8dp"
                app:borderStrokeWidth="2.2dp"
                app:labelText="@string/groupbox_select_device_text"
                app:labelTextColor="#128ba6"
                app:labelTextSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/groupBoxLayoutScan">

                <ListView
                    android:id="@+id/listView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:adapter="@{adapter}"
                    android:foregroundGravity="center"
                    android:onItemClick="@{(p, v, pos, i)-> viewModel.handleListViewItemSelected(pos)}"
                    android:textAlignment="center" />
            </ir.programmerplus.groupbox.GroupBoxLayout>

            <TextView
                android:id="@+id/textViewDeviceState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/textview_device_detection_not_found_text"
                android:textColor="#121111"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStopConnection"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:backgroundTint="#128ba6"
                android:fontFamily="sans-serif-medium"
                android:onClick="@{()-> viewModel.handleStopConnectionButton()}"
                android:text="@string/button_stop_connection_text"
                android:textAlignment="viewStart"
                android:textColor="@color/ap_black"
                android:textSize="18sp"
                android:visibility="@{!config.INSTANCE.connected ? View.VISIBLE : View.INVISIBLE}"
                app:cornerRadius="5dp"
                app:elevation="50dp"
                app:icon="@drawable/bluetooth_end_connection"
                app:iconPadding="5dp"
                app:iconSize="30dp"
                app:iconTint="@color/ap_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/groupBoxLayoutDeviceList" />

            <FrameLayout
                android:id="@+id/frameLayoutStopConnection"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FFFFFF"
                android:backgroundTint="#D7EEEEEE"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ProgressBar
                    android:id="@+id/progressBarStopConnection"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="66dp"
                    android:layout_height="67dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/design_default_color_secondary_variant" />
            </FrameLayout>

            <TextView
                android:id="@+id/textViewDeviceScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/textview_detect_device_text"
                android:textAlignment="center"
                android:textColor="#128ba6"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="TextContrastCheck" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>