<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.alcanl.cleverear.R"/>
        <import type="com.alcanl.cleverear.viewmodel.BeaconFragmentListenersViewModel"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.GlobalKt"/>
        <import type="android.content.Context"/>
        <import type="androidx.core.content.ContextCompat"/>
        <import type="android.view.View"/>
        <variable name="viewModel" type="BeaconFragmentListenersViewModel" />
        <variable name="config" type="ConfigurationModule" />
    </data>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="false"
        app:shimmer_duration="1000"
        android:background="@drawable/background"
        tools:context=".BeaconActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="vertical" >

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal" >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/main_logo_description_text"
                    android:src="@drawable/eartechnic_logo"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textAlignment="center"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="5dp"
                    android:text="@string/textview_eddystone_description_text"
                    android:textColor="#128ba6"
                    android:textSize="20sp"
                    tools:ignore="RtlCompat,TextContrastCheck" />


            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/frameLayoutNotSupported"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/textViewEddystoneNotSupported"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="65dp"
                        android:textSize="16sp"
                        android:text="@string/textview_eddystone_not_supported_text"
                        android:textAlignment="center"
                        android:textColor="#128ba6"
                        tools:ignore="TextContrastCheck" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        app:srcCompat="@drawable/icon_warning"
                        tools:ignore="ImageContrastCheck" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutMain"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ir.programmerplus.groupbox.GroupBoxLayout
                        android:id="@+id/groupBoxLayoutLeftDevice"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layoutDirection="ltr"
                        android:padding="8dp"
                        app:borderColor="#01579B"
                        app:borderCornerRadius="8dp"
                        app:borderStrokeWidth="2.2dp"
                        app:labelText="@string/textview_left_device_text"
                        app:labelTextColor="@color/ap_black"
                        app:labelTextSize="13dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.google.android.material.card.MaterialCardView
                            style="?attr/materialCardViewElevatedStyle"
                            android:backgroundTint="@color/ap_transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:checkable="false"
                            android:clickable="false"
                            android:focusable="true"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewSteps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="@string/textview_tlm_step_count_text"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@+id/appCompatTextViewStepCount"
                                    app:layout_constraintStart_toStartOf="parent"
                                    tools:ignore="TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewStepCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:text="@{String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Left).component6() : 0)}"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.green_variant : R.color.default_button_color)}"
                                    android:textSize="35sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/textview_tlm_today_text"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="10sp"
                                    android:textStyle="normal"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextViewStepCount"
                                    tools:ignore="SmallSp,TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/imageViewStepsLeft"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center"
                                    android:layout_marginEnd="30dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_bias="0.609"
                                    app:srcCompat="@{ContextCompat.getDrawable(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null  ? R.drawable.outline_body_system_60_variant : R.drawable.outline_body_system_60_gray)}"
                                    tools:ignore="ImageContrastCheck" />


                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/materialCardView2"
                            style="?attr/materialCardViewElevatedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:backgroundTint="@color/ap_transparent"
                            android:checkable="false"
                            android:clickable="false"
                            android:focusable="true"
                            android:padding="0dp"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextTemperatureDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="@string/textview_tlm_temperature_text"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@+id/appCompatTextViewTemperature"
                                    app:layout_constraintStart_toStartOf="parent"
                                    tools:ignore="TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewTemperature"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:text="@{String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Left).component3() : 0.0)}"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.right_device_slider : R.color.default_button_color)}"
                                    android:textSize="35sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewDegree"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/degree_symbol"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.right_device_slider : R.color.default_button_color)}"
                                    android:textSize="35sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/appCompatTextViewTemperature"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:ignore="TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewTemperatureWarnLeft"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginTop="2dp"
                                    android:visibility="@{config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Left).isLowTemperature() || config.INSTANCE.eddyStoneMap.get(EarSide.Left).isHighTemperature() ? View.VISIBLE : View.INVISIBLE : View.INVISIBLE}"
                                    android:text="@{config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Left).isLowTemperature() ? ContextCompat.getString(context, R.string.textview_tlm_low_temperature_text) : config.INSTANCE.eddyStoneMap.get(EarSide.Left).isHighTemperature() ? ContextCompat.getString(context, R.string.textview_tlm_high_temperature_text) : ContextCompat.getString(context, R.string.empty_string) : ContextCompat.getString(context, R.string.empty_string)}"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="10sp"
                                    android:textStyle="normal"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextViewTemperature"
                                    tools:ignore="SmallSp" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/imageViewTemperatureLeft"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center"
                                    android:layout_marginEnd="30dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_bias="0.487"
                                    app:srcCompat="@{ContextCompat.getDrawable(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null  ? R.drawable.outline_dew_point_60_right : R.drawable.outline_dew_point_60_gray)}"
                                    tools:ignore="ImageContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="2dp"
                                    android:text="@string/textview_tlm_temperature_range_text"
                                    android:textAlignment="center"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="8sp"
                                    android:textStyle="normal"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    tools:ignore="SmallSp,TextContrastCheck" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@+id/materialCardView2"
                            android:layout_marginTop="10dp">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/buttonTrackLeftDevice"
                                android:layout_width="90dp"
                                android:layout_height="60dp"
                                android:layout_gravity="end |center_vertical"
                                android:layout_marginEnd="30dp"
                                android:backgroundTint="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? R.color.secondary_variant : R.color.default_button_color)}"
                                android:enabled="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? true : false}"
                                android:onClick="@{() -> viewModel.handleActiveEddystoneTrackingButton(EarSide.Left)}"
                                android:text="@string/button_enable_tracking_text"
                                android:textAlignment="center"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="DuplicateSpeakableTextCheck,RtlCompat,SpeakableTextPresentCheck,TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="10dp"
                                android:text="@string/textview_eddystone_tracking_description_text"
                                android:textAlignment="center"
                                android:textColor="@color/ap_black"
                                android:textSize="6sp"
                                android:visibility="@{config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null  ? View.VISIBLE : View.INVISIBLE}"
                                tools:ignore="RtlCompat,SmallSp,TextSizeCheck,TextContrastCheck" />
                        </FrameLayout>

                    </ir.programmerplus.groupbox.GroupBoxLayout>

                    <ir.programmerplus.groupbox.GroupBoxLayout
                        android:id="@+id/groupBoxLayoutRightDevice"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layoutDirection="ltr"
                        android:padding="8dp"
                        app:borderColor="#900D09"
                        app:borderCornerRadius="8dp"
                        app:borderStrokeWidth="2.2dp"
                        app:labelText="@string/textview_right_device_text"
                        app:labelTextColor="@color/ap_black"
                        app:labelTextSize="13dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.google.android.material.card.MaterialCardView
                            style="?attr/materialCardViewElevatedStyle"
                            android:backgroundTint="@color/ap_transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:checkable="false"
                            android:clickable="false"
                            android:focusable="true"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewStepsRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="@string/textview_tlm_step_count_text"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@+id/appCompatTextViewStepCountRight"
                                    app:layout_constraintStart_toStartOf="parent"
                                    tools:ignore="TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewStepCountRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:text="@{String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Right) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Right).component6() : 0)}"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.green_variant : R.color.default_button_color)}"
                                    android:textSize="35sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/textview_tlm_today_text"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="10sp"
                                    android:textStyle="normal"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextViewStepCountRight"
                                    tools:ignore="SmallSp,TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/imageViewStepsRight"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center"
                                    android:layout_marginEnd="30dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_bias="0.487"
                                    app:srcCompat="@{ContextCompat.getDrawable(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null  ? R.drawable.outline_body_system_60_variant : R.drawable.outline_body_system_60_gray)}"
                                    tools:ignore="ImageContrastCheck" />


                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/materialCardView"
                            style="?attr/materialCardViewElevatedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:backgroundTint="@color/ap_transparent"
                            android:checkable="false"
                            android:clickable="false"
                            android:focusable="true"
                            android:padding="0dp"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextTemperatureDescRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="@string/textview_tlm_temperature_text"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toTopOf="@+id/appCompatTextViewTemperatureRight"
                                    app:layout_constraintStart_toStartOf="parent"
                                    tools:ignore="TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewTemperatureRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:text="@{String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Right) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Right).component3() : 0.0)}"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.right_device_slider : R.color.default_button_color)}"
                                    android:textSize="35sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewDegreeRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/degree_symbol"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.right_device_slider : R.color.default_button_color)}"
                                    android:textSize="35sp"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/appCompatTextViewTemperatureRight"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:ignore="TextContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/appCompatTextViewTemperatureWarnRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="30dp"
                                    android:layout_marginTop="2dp"
                                    android:text="@{config.INSTANCE.eddyStoneMap.get(EarSide.Right) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Right).isLowTemperature() ? ContextCompat.getString(context, R.string.textview_tlm_low_temperature_text) : config.INSTANCE.eddyStoneMap.get(EarSide.Right).isHighTemperature() ? ContextCompat.getString(context, R.string.textview_tlm_high_temperature_text) : ContextCompat.getString(context, R.string.empty_string) : ContextCompat.getString(context, R.string.empty_string)}"
                                    android:visibility="@{config.INSTANCE.eddyStoneMap.get(EarSide.Right) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Right).isLowTemperature() || config.INSTANCE.eddyStoneMap.get(EarSide.Right).isHighTemperature() ? View.VISIBLE : View.INVISIBLE : View.INVISIBLE}"
                                    android:textAlignment="viewStart"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="10sp"
                                    android:textStyle="normal"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/appCompatTextViewTemperatureRight"
                                    tools:ignore="SmallSp" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/imageViewTemperatureRight"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_gravity="center"
                                    android:layout_marginEnd="30dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_bias="0.487"
                                    app:srcCompat="@{ContextCompat.getDrawable(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null  ? R.drawable.outline_dew_point_60_right : R.drawable.outline_dew_point_60_gray)}"
                                    tools:ignore="ImageContrastCheck" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="2dp"
                                    android:text="@string/textview_tlm_temperature_range_text"
                                    android:textAlignment="center"
                                    android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? R.color.black : R.color.default_button_color)}"
                                    android:textSize="8sp"
                                    android:textStyle="normal"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    tools:ignore="SmallSp,TextContrastCheck" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@+id/materialCardView"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="10dp"
                                android:text="@string/textview_eddystone_tracking_description_text"
                                android:textAlignment="center"
                                android:textColor="@color/ap_black"
                                android:textSize="6sp"
                                android:visibility="@{config.INSTANCE.eddyStoneMap.get(EarSide.Right) != null  ? View.VISIBLE : View.INVISIBLE}"
                                tools:ignore="RtlCompat,SmallSp,TextSizeCheck,TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/buttonTrackRightDevice"
                                android:layout_width="90dp"
                                android:layout_height="60dp"
                                android:layout_gravity="end | center_vertical"
                                android:layout_marginEnd="30dp"
                                android:backgroundTint="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.secondary_variant : R.color.default_button_color : R.color.default_button_color)}"
                                android:enabled="@{config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? true : false}"
                                android:onClick="@{() -> viewModel.handleActiveEddystoneTrackingButton(EarSide.Right)}"
                                android:text="@string/button_enable_tracking_text"
                                android:textAlignment="center"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="RtlCompat,SpeakableTextPresentCheck,TextContrastCheck" />
                        </FrameLayout>

                    </ir.programmerplus.groupbox.GroupBoxLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</layout>