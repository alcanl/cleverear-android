<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.alcanl.cleverear.R"/>
        <import type="com.alcanl.cleverear.viewmodel.BeaconFragmentListenersViewModel"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.GlobalKt"/>
        <import type="android.content.Context"/>
        <import type="androidx.core.content.ContextCompat"/>
        <import type="android.view.View"/>
        <variable name="viewModel" type="BeaconFragmentListenersViewModel" />
        <variable name="config" type="ConfigurationModule" />
    </data>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="false"
        app:shimmer_duration="1000"
        android:background="@drawable/background"
        tools:context=".BeaconActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="vertical" >

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal" >

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/main_logo_description_text"
                    android:src="@drawable/eartechnic_logo"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textAlignment="center"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="5dp"
                    android:text="@string/textview_eddystone_description_text"
                    android:textColor="#128ba6"
                    android:textSize="20sp"
                    tools:ignore="RtlCompat,TextContrastCheck" />


            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/frameLayoutNotSupported"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/textViewEddystoneNotSupported"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="65dp"
                        android:textSize="16sp"
                        android:text="@string/textview_eddystone_not_supported_text"
                        android:textAlignment="center"
                        android:textColor="#128ba6"
                        tools:ignore="TextContrastCheck" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        app:srcCompat="@drawable/icon_warning"
                        tools:ignore="ImageContrastCheck" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutMain"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ir.programmerplus.groupbox.GroupBoxLayout
                        android:id="@+id/groupBoxLayoutLeftDevice"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layoutDirection="ltr"
                        android:padding="8dp"
                        app:borderColor="#A8A3A3"
                        app:borderCornerRadius="8dp"
                        app:borderStrokeWidth="2.2dp"
                        app:labelText="@string/textview_left_device_text"
                        app:labelTextColor="@color/ap_black"
                        app:labelTextSize="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_version_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"
                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewLeftDeviceTLMVersion"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left).component1()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"
                                 />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_battery_voltage_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"
                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewLeftDeviceTLMBatteryVoltage"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left).component2()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_temperature_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewLeftDeviceTLMTemperature"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left).component3()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_advertisement_count_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewLeftDeviceTLMAdvertisementCount"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left).component4()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_elapsed_time_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewLeftDeviceTLMElapsedTime"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left).component5()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_step_count_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}"                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewLeftDeviceTLMStepCount"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Left).component6()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.left_device_slider : R.color.default_button_color : R.color.default_button_color)}" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/buttonTrackLeftDevice"
                                android:layout_width="90dp"
                                android:layout_height="60dp"
                                android:layout_gravity="end |center_vertical"
                                android:layout_marginEnd="10dp"
                                android:textAlignment="center"
                                android:backgroundTint="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.secondary_variant : R.color.default_button_color : R.color.default_button_color)}"
                                android:enabled="@{config.INSTANCE.hearingAidMap.get(EarSide.Left) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Left).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? true : false : false}"
                                android:onClick="@{() -> viewModel.handleActiveEddystoneTrackingButton(EarSide.Left)}"
                                android:text="@{config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null ? config.INSTANCE.eddyStoneMap.get(EarSide.Left).isTrackingActive() ? R.string.button_disable_tracking_text : R.string.button_enable_tracking_text : R.string.button_enable_tracking_text}"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:ignore="DuplicateSpeakableTextCheck,RtlCompat,SpeakableTextPresentCheck,TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="10dp"
                                android:text="@string/textview_eddystone_tracking_description_text"
                                android:textAlignment="center"
                                android:textColor="@color/ap_black"
                                android:textSize="6sp"
                                android:visibility="@{config.INSTANCE.eddyStoneMap.get(EarSide.Left) != null  ? View.VISIBLE : View.INVISIBLE}"
                                tools:ignore="RtlCompat,SmallSp,TextSizeCheck,TextContrastCheck" />
                        </FrameLayout>

                    </ir.programmerplus.groupbox.GroupBoxLayout>

                    <ir.programmerplus.groupbox.GroupBoxLayout
                        android:id="@+id/groupBoxLayoutRightDevice"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="15dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layoutDirection="ltr"
                        android:padding="8dp"
                        app:borderColor="#A8A3A3"
                        app:borderCornerRadius="8dp"
                        app:borderStrokeWidth="2.2dp"
                        app:labelText="@string/textview_right_device_text"
                        app:labelTextColor="@color/ap_black"
                        app:labelTextSize="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_version_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.right_device_slider : R.color.default_button_color : R.color.default_button_color)}"                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewRightDeviceTLMVersion"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Right).component1()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.right_device_slider : R.color.default_button_color : R.color.default_button_color)}" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_battery_voltage_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.right_device_slider : R.color.default_button_color : R.color.default_button_color)}"
                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewRightDeviceTLMBatteryVoltage"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@{config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? String.valueOf(config.INSTANCE.eddyStoneMap.get(EarSide.Right).component2()) : ContextCompat.getString(context, R.string.textview_eddystone_not_supporting_text)  : ContextCompat.getString(context, R.string.textview_eddystone_not_connected_device_text)}"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.right_device_slider : R.color.default_button_color : R.color.default_button_color)}" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="@string/textview_tlm_temperature_text"
                                android:textAlignment="center"
                                android:textColor="@{ContextCompat.getColor(context, config.INSTANCE.hearingAidMap.get(EarSide.Right) != null ? config.INSTANCE.hearingAidMap.get(EarSide.Right).getModelNumber().equals(GlobalKt.EDDYSTONE_SUPPORTED_AID_MODEL_NUMBER) ? R.color.right_device_slider : R.color.default_button_color : R.color.default_button_color)}"                                tools:ignore="TextContrastCheck" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/textViewRightDeviceTLMTemperature"
                                android:textAlignment="center"
                                android:textSize="12sp"
