<?xml version="1.0" encoding="utf-8"?>
  <layout xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.alcanl.cleverear.viewmodel.InSituFragmentListenersViewModel"/>
        <import type="com.alcanl.cleverear.di.module.FittingConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <import type="android.view.View"/>
        <import type="android.content.Context"/>
        <import type="androidx.core.content.ContextCompat"/>
        <import type="androidx.appcompat.content.res.AppCompatResources"/>
        <import type="com.alcanl.cleverear.R"/>
        <variable name="config" type="FittingConfigurationModule" />
        <variable name="viewModel" type="InSituFragmentListenersViewModel" />

    </data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".fitting.fragment.InSituFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/frameLayoutLeftEar"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.061"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.6">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:translationZ="90dp"
                android:visibility="@{config.INSTANCE.leftButtonSelected ? View.VISIBLE : View.INVISIBLE}"
                app:srcCompat="@drawable/check_tick"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonLeft"
                style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom | center"
                android:backgroundTint="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).product != null}"
                android:onClick="@{()-> viewModel.handleEarSideSelectButton(EarSide.Left)}"
                android:text="@string/left_ear_side_text"
                android:textAllCaps="false"
                android:textStyle="normal"
                app:cornerRadius="0dp" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameLayoutRightEar"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.938"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.6">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom | center"
                android:backgroundTint="@{config.INSTANCE.rightButtonSelected ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).product != null}"
                android:onClick="@{()-> viewModel.handleEarSideSelectButton(EarSide.Right)}"
                android:text="@string/right_ear_side_text"
                android:textAllCaps="false"
                android:textStyle="normal"
                app:cornerRadius="0dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:translationZ="90dp"
                android:visibility="@{config.INSTANCE.rightButtonSelected ? View.VISIBLE : View.INVISIBLE}"
                app:srcCompat="@drawable/check_tick"
                tools:ignore="ContentDescription,ImageContrastCheck" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutSoundGenerate"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayoutFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">


            <Button
                android:id="@+id/buttonMinusFiveDecibel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="74dp"
                android:layout_height="35dp"
                android:onClick="@{()-> viewModel.handleDecibelButtons(-5)}"
                android:text="@string/button_minus_five_text"
                android:textAlignment="center"
                android:textColor="@color/right_device_slider"
                android:textSize="11sp"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.175"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.047"
                app:strokeColor="@color/right_device_slider"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/buttonPlusFiveDecibel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="74dp"
                android:layout_height="35dp"
                android:onClick="@{()-> viewModel.handleDecibelButtons(5)}"
                android:text="@string/button_plus_five_text"
                android:textAlignment="center"
                android:textColor="@color/right_device_slider"
                android:textSize="11sp"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.818"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.047"
                app:strokeColor="@color/right_device_slider"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/textViewDecibel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_decibel_text"
                android:textColor="@color/right_device_slider"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonPlusFiveDecibel"
                app:layout_constraintHorizontal_bias="0.478"
                app:layout_constraintStart_toEndOf="@+id/buttonMinusFiveDecibel"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.156" />

            <ImageButton
                android:id="@+id/imageButtonDecreaseFrequency"
                android:layout_width="74dp"
                android:layout_height="30dp"
                android:background="@drawable/in_situ_buttons_border"
                android:onClick="@{(view)-> viewModel.handleFrequencyButtons(view)}"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.175"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.433"
                app:srcCompat="@drawable/baseline_arrow_back_ios_24"
                app:strokeColor="@color/left_device_slider"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/imageButtonIncreaseFrequency"
                android:layout_width="74dp"
                android:layout_height="30dp"
                android:background="@drawable/in_situ_buttons_border"
                android:onClick="@{(view)-> viewModel.handleFrequencyButtons(view)}"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.818"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.433"
                app:srcCompat="@drawable/baseline_arrow_forward_ios_24"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck,TouchTargetSizeCheck,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/textViewFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/textview_frequency_hertz_text"
                android:textColor="@color/left_device_slider"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imageButtonIncreaseFrequency"
                app:layout_constraintHorizontal_bias="0.512"
                app:layout_constraintStart_toEndOf="@+id/imageButtonDecreaseFrequency"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.48" />

            <Button
                android:id="@+id/buttonPlaySound"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:onClick="@{()-> viewModel.handlePlaySoundButton()}"
                android:text="@string/button_play_sound_text"
                android:textColor="@color/design_default_color_secondary_variant"
                android:textSize="11sp"
                app:cornerRadius="0dp"
                app:icon="@drawable/baseline_play_arrow_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.497"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0"
                app:strokeColor="@color/design_default_color_secondary_variant"
                tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/appCompatImageView2"
            android:layout_width="90dp"
            android:layout_height="65dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.983"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.024"
            app:srcCompat="@drawable/eartechnic_logo"
            tools:ignore="ContentDescription" />

        <Button
            android:id="@+id/button3"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginStart="10dp"
            android:onClick="@{()-> viewModel.handleSaveButton()}"
            android:text="@string/button_save_in_situ_text"
            android:textColor="@color/design_default_color_secondary_variant"
            android:textSize="11sp"
            app:cornerRadius="0dp"
            app:icon="@drawable/baseline_save_alt_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.533"
            app:strokeColor="@color/design_default_color_secondary_variant"
            tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />

        <Button
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:onClick="@{()-> viewModel.handleAutoFitButton()}"
            android:text="@string/button_auto_fit_text"
            android:textColor="@color/design_default_color_secondary_variant"
            android:textSize="11sp"
            app:cornerRadius="0dp"
            app:icon="@drawable/baseline_add_circle_outline_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/button3"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/design_default_color_secondary_variant"
            tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutChart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayoutSoundGenerate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayoutHeader">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

</layout>