<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:ignore="VisualLintBounds">

    <data>
        <import type="com.alcanl.cleverear.viewmodel.FittingFragmentListenersViewModel"/>
        <import type="com.alcanl.cleverear.di.module.FittingConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <import type="android.widget.ArrayAdapter"/>
        <import type="com.ark.ParameterSpace"/>
        <import type="android.view.View"/>
        <import type="android.content.Context"/>
        <import type="androidx.core.content.ContextCompat"/>
        <import type="androidx.appcompat.content.res.AppCompatResources"/>
        <import type="com.alcanl.cleverear.R"/>
        <variable name="isEqualizerEnabled" type="boolean" />
        <variable name="config" type="FittingConfigurationModule" />
        <variable name="viewModel" type="FittingFragmentListenersViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background"
        tools:context=".fitting.fragment.InSituFragment">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayoutBurn">

            <FrameLayout
                android:id="@+id/frameLayoutLeftEar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.061"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.6">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="14dp"
                    android:translationZ="90dp"
                    android:visibility="@{config.INSTANCE.selectedEarSide == EarSide.Left ? View.VISIBLE : View.INVISIBLE}"
                    app:srcCompat="@drawable/check_tick"
                    tools:ignore="ContentDescription,ImageContrastCheck" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonLeft"
                    style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom | center"
                    android:backgroundTint="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                    android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).product != null}"
                    android:onClick="@{()-> viewModel.handleEarSideSelectButton(EarSide.Left)}"
                    android:text="@string/left_ear_side_text"
                    android:textAllCaps="false"
                    android:textStyle="normal"
                    app:cornerRadius="0dp" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutRightEar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.938"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.6">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom | center"
                    android:backgroundTint="@{config.INSTANCE.selectedEarSide == EarSide.Right ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                    android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).product != null}"
                    android:onClick="@{()-> viewModel.handleEarSideSelectButton(EarSide.Right)}"
                    android:text="@string/right_ear_side_text"
                    android:textAllCaps="false"
                    android:textStyle="normal"
                    app:cornerRadius="0dp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:translationZ="90dp"
                    android:visibility="@{config.INSTANCE.selectedEarSide == EarSide.Right ? View.VISIBLE : View.INVISIBLE}"
                    app:srcCompat="@drawable/check_tick"
                    tools:ignore="ContentDescription,ImageContrastCheck" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/appCompatImageViewLogo"
            android:layout_width="55dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.945"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.00999999"
            app:srcCompat="@drawable/eartechnic_logo"
            tools:ignore="ContentDescription" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutBurn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/table_layout_border"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayoutFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutRetentions">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonBurn"
                style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:onClick="@{(view) -> viewModel.handleBurnButtonsClicked(view)}"
                android:text="@string/button_burn_text"
                android:textAllCaps="false"
                android:textColor="@color/ap_black"
                android:textSize="12sp"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.167"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.111"
                app:strokeColor="@color/design_default_color_secondary_variant"
                tools:ignore="TouchTargetSizeCheck" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonBurnAll"
                style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                android:layout_width="160dp"
                android:layout_height="36dp"
                android:onClick="@{(view) -> viewModel.handleBurnButtonsClicked(view)}"
                android:text="@string/button_burn_to_all_text"
                android:textAllCaps="false"
                android:textColor="@color/ap_black"
                android:textSize="12sp"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.034"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonBurn"
                app:layout_constraintVertical_bias="0.333"
                app:strokeColor="@color/design_default_color_secondary_variant"
                tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />

            <ImageView
                android:id="@+id/imageViewSave"
                android:layout_width="80dp"
                android:layout_height="70dp"
                android:scaleType="fitXY"
                android:src="@drawable/baseline_save_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutEqualizer"
            android:layout_width="0dp"
            android:layout_height="195dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/table_layout_border"
            app:layout_constraintBottom_toTopOf="@+id/linearLayoutFeedbackAndNoiseReduction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinnerMemory"
            tools:ignore="TextSizeCheck">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:scaleType="fitXY"
                android:src="@drawable/baseline_equalizer_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.106"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.28"
                tools:ignore="ContentDescription" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTreble"
                android:layout_width="166dp"
                android:layout_height="45dp"
                android:enabled="@{isEqualizerEnabled}"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.96"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewTreble"
                app:onValueChangeListener="@{(value) -> viewModel.handleTrebleSliderOnValueChanged(value)}"
                app:thumbColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck,VisualLintBounds" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBass"
                android:layout_width="166dp"
                android:layout_height="45dp"
                android:enabled="@{isEqualizerEnabled}"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.96"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBass"
                app:onValueChangeListener="@{(value) -> viewModel.handleBassSliderOnValueChanged(value)}"
                app:thumbColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <CheckBox
                android:id="@+id/checkBoxEqualizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/design_default_color_secondary_variant"
                android:checked="@{config.INSTANCE.deviceInfoExtMap.get(config.INSTANCE.selectedEarSide).isEqualizerEnabled()}"
                android:onCheckedChanged="@{() -> viewModel.handleCheckBoxEqualizerCheckedChanged()}"
                android:text="@string/checkbox_equalizer_text"
                android:textColor="@color/ap_black"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.13"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView5" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMid"
                android:layout_width="166dp"
                android:layout_height="45dp"
                android:enabled="@{isEqualizerEnabled}"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.96"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewMid"
                app:onValueChangeListener="@{(value) -> viewModel.handleMidSliderOnValueChanged(value)}"
                app:thumbColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/textViewMid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textview_mid_text"
                android:textAlignment="center"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.76"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderBass"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/textViewTreble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textview_treble_text"
                android:textAlignment="center"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.76"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderMid"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/textViewBass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/textview_bass_text"
                android:textAlignment="center"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.76"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SmallSp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.skydoves.powerspinner.PowerSpinnerView
            android:id="@+id/spinnerMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="@string/textview_active_memory_text"
            android:textAlignment="center"
            android:textColor="@color/design_default_color_secondary_variant"
            android:textColorHint="@color/design_default_color_secondary_variant"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/appCompatImageViewLogo"
            app:layout_constraintHorizontal_bias="0.24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.025"
            app:onItemSelected="@{(pos) -> viewModel.handleSpinnerItemSelect(pos)}"
            app:spinner_arrow_animate_duration="700"
            app:spinner_arrow_tint="@color/design_default_color_secondary_variant"
            app:spinner_divider_color="@color/design_default_color_secondary_variant"
            app:spinner_divider_show="true"
            app:spinner_item_height="30dp"
            app:spinner_popup_animation="dropdown"
            app:spinner_popup_background="@color/off_white"
            app:spinner_popup_elevation="8dp"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck,TextContrastCheck" />

        <LinearLayout
            android:id="@+id/linearLayoutWideBandGain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/table_layout_border"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/linearLayoutRetentions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.476"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutFeedbackAndNoiseReduction">

            <com.google.android.material.slider.Slider
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="3"
                android:value="@{config.INSTANCE.deviceInfoExtMap.get(config.INSTANCE.selectedEarSide).getProductWideBandValue()}"
                android:valueFrom="0"
                android:valueTo="42"
                app:haloColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:onValueChangeListener="@{(value)-> viewModel.handleWideBandSliderOnValueChanged(value)}"
                app:thumbColor="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.selectedEarSide == EarSide.Left ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck,VisualLintBounds" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="7"
                android:textColor="@color/ap_black"
                android:text="@string/textview_wideband_text"
                android:textAlignment="center"
                android:textSize="10sp"
                tools:ignore="SmallSp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutFeedbackAndNoiseReduction"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/table_layout_border"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/linearLayoutWideBandGain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.761"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayoutEqualizer">

            <CheckBox
                android:id="@+id/checkBoxFeedbackCanceler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/design_default_color_secondary_variant"
                android:checked="@{config.INSTANCE.deviceInfoExtMap.get(config.INSTANCE.selectedEarSide).isFeedbackCancelerEnabled()}"
                android:onCheckedChanged="@{() -> viewModel.handleCheckBoxFeedbackCancelerCheckedChanged()}"
                android:padding="5dp"
                android:text="@string/checkbox_feedback_text"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                tools:ignore="SmallSp,TouchTargetSizeCheck,VisualLintButtonSize" />

            <CheckBox
                android:id="@+id/checkBoxNoiseReduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:buttonTint="@color/design_default_color_secondary_variant"
                android:checked="@{config.INSTANCE.deviceInfoExtMap.get(config.INSTANCE.selectedEarSide).isNoiseReductionEnabled()}"
                android:onCheckedChanged="@{()-> viewModel.handleCheckBoxNoiseReductionCheckedChanged()}"
                android:padding="5dp"
                android:text="@string/checkbox_noise_reduction_text"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                tools:ignore="SmallSp,VisualLintButtonSize,TouchTargetSizeCheck" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutRetentions"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/table_layout_border"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayoutBurn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.761"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutWideBandGain">

            <CheckBox
                android:id="@+id/checkBoxMemoryRetention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/design_default_color_secondary_variant"
                android:checked="@{config.INSTANCE.deviceInfoExtMap.get(config.INSTANCE.selectedEarSide).isMemoryRetentionEnabled()}"
                android:onCheckedChanged="@{()-> viewModel.handleMemoryRetentionCheckedChanged()}"
                android:padding="5dp"
                android:text="@string/checkbox_memory_retention_text"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                tools:ignore="SmallSp,VisualLintButtonSize,TouchTargetSizeCheck" />

            <CheckBox
                android:id="@+id/checkBoxVolumeRetention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:buttonTint="@color/design_default_color_secondary_variant"
                android:checked="@{config.INSTANCE.deviceInfoExtMap.get(config.INSTANCE.selectedEarSide).isVolumeRetentionEnabled()}"
                android:onCheckedChanged="@{()-> viewModel.handleVolumeRetentionCheckedChanged()}"
                android:padding="5dp"
                android:text="@string/checkbox_volume_retention_text"
                android:textColor="@color/ap_black"
                android:textSize="10sp"
                tools:ignore="SmallSp,TouchTargetSizeCheck,VisualLintButtonSize" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutLoading"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:background="@drawable/background"
            android:backgroundTint="#CEFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.razzaghimahdi78.dotsloading.circle.LoadingCircleFady
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dots_color="@color/design_default_color_secondary_variant"
                app:dots_size="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" >

            </com.razzaghimahdi78.dotsloading.circle.LoadingCircleFady>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>