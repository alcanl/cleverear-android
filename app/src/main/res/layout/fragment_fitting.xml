<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.alcanl.cleverear.viewmodel.FittingFragmentListenersViewModel"/>
        <import type="com.alcanl.cleverear.di.module.FittingConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <import type="android.widget.ArrayAdapter"/>
        <import type="com.ark.ParameterSpace"/>
        <import type="android.view.View"/>
        <import type="android.content.Context"/>
        <import type="androidx.core.content.ContextCompat"/>
        <import type="androidx.appcompat.content.res.AppCompatResources"/>
        <import type="com.alcanl.cleverear.R"/>
        <variable type="ArrayAdapter&lt;ParameterSpace&gt;" name="memoryAdapter" />
        <variable name="config" type="FittingConfigurationModule" />
        <variable name="viewModel" type="FittingFragmentListenersViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background"
        tools:context=".fitting.fragment.InSituFragment">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/frameLayoutLeftEar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.061"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.6">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="14dp"
                    android:translationZ="90dp"
                    android:visibility="@{config.INSTANCE.leftButtonSelected ? View.VISIBLE : View.INVISIBLE}"
                    app:srcCompat="@drawable/check_tick"
                    tools:ignore="ContentDescription,ImageContrastCheck" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonLeft"
                    style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom | center"
                    android:backgroundTint="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                    android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).product != null}"
                    android:onClick="@{()-> viewModel.handleEarSideSelectButton(EarSide.Left)}"
                    android:text="@string/left_ear_side_text"
                    android:textAllCaps="false"
                    android:textStyle="normal"
                    app:cornerRadius="0dp" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameLayoutRightEar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.938"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.6">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom | center"
                    android:backgroundTint="@{config.INSTANCE.rightButtonSelected ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                    android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).product != null}"
                    android:onClick="@{()-> viewModel.handleEarSideSelectButton(EarSide.Right)}"
                    android:text="@string/right_ear_side_text"
                    android:textAllCaps="false"
                    android:textStyle="normal"
                    app:cornerRadius="0dp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:translationZ="90dp"
                    android:visibility="@{config.INSTANCE.rightButtonSelected ? View.VISIBLE : View.INVISIBLE}"
                    app:srcCompat="@drawable/check_tick"
                    tools:ignore="ContentDescription,ImageContrastCheck" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/appCompatImageViewLogo"
            android:layout_width="100dp"
            android:layout_height="88dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.945"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.00999999"
            app:srcCompat="@drawable/eartechnic_logo"
            tools:ignore="ContentDescription" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutBurn"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_margin="10dp"
            android:background="@drawable/table_layout_border"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayoutFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonBurn"
                style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginTop="32dp"
                android:text="Burn"
                android:textAllCaps="false"
                android:textColor="@color/ap_black"
                app:cornerRadius="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.17"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/design_default_color_secondary_variant"
                tools:ignore="TouchTargetSizeCheck" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonBurnAll"
                style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:text="Burn All Memories"
                android:textAllCaps="false"
                android:textColor="@color/ap_black"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.034"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonBurn"
                app:layout_constraintVertical_bias="0.333"
                app:strokeColor="@color/design_default_color_secondary_variant"
                tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />

            <ImageView
                android:id="@+id/imageViewSave"
                android:layout_width="120dp"
                android:layout_height="110dp"
                android:scaleType="fitXY"
                android:src="@drawable/baseline_save_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutEqualizer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/table_layout_border"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appCompatImageViewLogo">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:scaleType="fitXY"
                android:src="@drawable/baseline_equalizer_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.099"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.41000003"
                tools:ignore="ContentDescription" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTreble"
                android:layout_width="166dp"
                android:layout_height="55dp"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.96"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewTreble"
                app:onValueChangeListener="@{(view) -> viewModel.handleSliderOnValueChanged(view)}"
                app:thumbColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBass"
                android:layout_width="166dp"
                android:layout_height="55dp"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.966"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBass"
                app:onValueChangeListener="@{(view) -> viewModel.handleSliderOnValueChanged(view)}"
                app:thumbColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <CheckBox
                android:id="@+id/checkBoxEqualizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="@{config.INSTANCE.leftButtonSelected ? config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).isEqualizerEnabled() : config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).isEqualizerEnabled()}"
                android:onCheckedChanged="@{() -> viewModel.handleCheckBoxCheckedChanged()}"
                android:text="Equalizer"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView5" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderMid"
                android:layout_width="166dp"
                android:layout_height="55dp"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.96"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewMid"
                app:onValueChangeListener="@{(view) -> viewModel.handleSliderOnValueChanged(view)}"
                app:thumbColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/textViewMid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mid"
                android:textAlignment="center"
                android:textColor="@color/ap_black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.767"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderBass" />

            <TextView
                android:id="@+id/textViewTreble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Treble"
                android:textAlignment="center"
                android:textColor="@color/ap_black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.771"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sliderMid" />

            <TextView
                android:id="@+id/textViewBass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Bass"
                android:textAlignment="center"
                android:textColor="@color/ap_black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.768"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Spinner
            android:id="@+id/spinnerMemory"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adapter="@{memoryAdapter}"
            android:onItemSelected="@{(av, v, pos, i) -> viewModel.handleSpinnerItemSelect(pos)}"
            android:selectedItemPosition="@={}"
            android:textAlignment="center"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@+id/appCompatImageViewLogo"
            app:layout_constraintHorizontal_bias="0.51"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Program"
            android:textColor="@color/design_default_color_secondary_variant"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayoutEqualizer"
            app:layout_constraintEnd_toStartOf="@+id/appCompatImageViewLogo"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.329"
            tools:ignore="TextContrastCheck" />

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/table_layout_border"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayoutBurn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.476"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

            <com.google.android.material.slider.Slider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="3"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:haloColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbColor="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:thumbHeight="30dp"
                app:thumbRadius="16dp"
                app:trackColorActive="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, R.color.left_device_slider) : ContextCompat.getColor(context, R.color.right_device_slider)}"
                app:trackColorInactive="#A8A3A3"
                app:trackHeight="12dp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="7"
                android:text="Wideband Gain"
                android:textAlignment="center"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/table_layout_border"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.761"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayoutEqualizer">

            <CheckBox
                android:id="@+id/checkBoxFeedbackCanceler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="10dp"
                android:text="Feedback Canceler"
                android:textColor="@color/ap_black"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/checkBoxNoiseReduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:padding="10dp"
                android:layout_weight="1"
                android:text="Noise Reduction"
                android:textColor="@color/ap_black"
                android:textSize="12sp" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>