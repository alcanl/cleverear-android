<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
xmlns:android="http://schemas.android.com/apk/res/android">
<data>
    <import type="com.alcanl.cleverear.viewmodel.HomeFragmentListenersViewModel"/>
    <import type="com.alcanl.cleverear.di.module.FittingConfigurationModule"/>
    <import type="com.alcanl.cleverear.util.EarSide"/>
    <import type="android.view.View"/>
    <import type="android.content.Context"/>
    <import type="androidx.core.content.ContextCompat"/>
    <import type="androidx.appcompat.content.res.AppCompatResources"/>
    <import type="com.alcanl.cleverear.R"/>
    <variable name="config" type="FittingConfigurationModule" />
    <variable name="viewModel" type="HomeFragmentListenersViewModel" />

</data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewInitialize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:text="@string/textview_initializing_text"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/design_default_color_secondary_variant"
        android:textSize="14sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.16"
        tools:ignore="TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/appCompatImageView"
        android:layout_width="100dp"
        android:layout_height="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.019"
        app:srcCompat="@drawable/eartechnic_logo"
        tools:ignore="ContentDescription" />

    <com.razzaghimahdi78.dotsloading.linear.LoadingScaly
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:dots_color="@color/design_default_color_secondary_variant"
        app:dots_count="5"
        app:dots_duration="400"
        app:dots_size="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.251" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonRetry"
        android:layout_width="wrap_content"
        android:layout_height="57dp"
        android:backgroundTint="@color/design_default_color_secondary_variant"
        android:onClick="@{()->viewModel.handleRetryButton()}"
        android:text="@string/button_retry_text"
        android:textAllCaps="false"
        android:textColor="@color/ap_black"
        android:textSize="20sp"
        android:textStyle="normal"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.234" />

    <FrameLayout
        android:id="@+id/frameLayoutDeviceMac"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textview_device_mac"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/ap_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewDeviceMac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@{config.INSTANCE.selectedEarSide == EarSide.Left ? config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).deviceMac : config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).deviceMac}"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayoutDeviceModel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayoutDeviceMac">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textview_device_model"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewDeviceModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@{config.INSTANCE.selectedEarSide == EarSide.Left ? config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).deviceModelName : config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).deviceModelName}"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayoutLibraryId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayoutDeviceModel">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textview_library_id"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewLibraryId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@{config.INSTANCE.selectedEarSide == EarSide.Left ? config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).deviceLibraryId : config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).deviceLibraryId}"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayoutFirmwareId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayoutLibraryId">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textview_firmware_id"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewFirmwareId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@{config.INSTANCE.selectedEarSide == EarSide.Left ? config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).deviceFirmwareId : config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).deviceFirmwareId}"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayoutFirmwareVersion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayoutFirmwareId">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/textview_firmware_version"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewFirmwareVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@{config.INSTANCE.selectedEarSide == EarSide.Left ? config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).deviceFirmwareVersion : config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).deviceFirmwareVersion}"
            android:textAlignment="center"
            android:textColor="@color/ap_black"
            android:textSize="15sp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imageViewHearingAid"
        android:layout_width="65dp"
        android:layout_height="60dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.236"
        app:srcCompat="@drawable/tie_ha"
        tools:ignore="ContentDescription" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/frameLayoutLeftEar"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.061"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.6">

            <ImageView
                android:id="@+id/imageViewLeftEar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                app:srcCompat="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).product != null ? AppCompatResources.getDrawable(context, R.drawable.leftear_blue) : AppCompatResources.getDrawable(context, R.drawable.lefteargray)}"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top | center"
                android:layout_marginStart="40dp"
                android:layout_marginTop="15dp"
                android:visibility="@{config.INSTANCE.leftButtonSelected ? View.VISIBLE : View.INVISIBLE}"
                app:srcCompat="@drawable/check_tick"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonLeft"
                style="@style/ThemeOverlay.Material3.Button.ElevatedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom | center"
                android:backgroundTint="@{config.INSTANCE.leftButtonSelected ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Left).product != null}"
                android:onClick="@{()-> viewModel.handleEarSideButtons(EarSide.Left)}"
                android:text="@string/left_ear_side_text"
                android:textAllCaps="false"
                android:textStyle="normal"
                app:cornerRadius="0dp" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameLayoutRightEar"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.938"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.6">

            <ImageView
                android:id="@+id/imageViewRightEar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                app:srcCompat="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).product != null ? AppCompatResources.getDrawable(context, R.drawable.rightear_red) : AppCompatResources.getDrawable(context, R.drawable.righteargray) }"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom | center"
                android:backgroundTint="@{config.INSTANCE.rightButtonSelected ? ContextCompat.getColor(context, com.google.android.material.R.color.design_default_color_secondary_variant) : ContextCompat.getColor(context, com.androidplot.R.color.ap_gray)}"
                android:enabled="@{config.INSTANCE.deviceInfoExtMap.get(EarSide.Right).product != null}"
                android:onClick="@{()-> viewModel.handleEarSideButtons(EarSide.Right)}"
                android:text="@string/right_ear_side_text"
                android:textAllCaps="false"
                android:textStyle="normal"
                app:cornerRadius="0dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top | center"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="40dp"
                android:visibility="@{config.INSTANCE.rightButtonSelected ? View.VISIBLE : View.INVISIBLE}"
                app:srcCompat="@drawable/check_tick"
                tools:ignore="ContentDescription,ImageContrastCheck" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>