<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="com.alcanl.cleverear.viewmodel.AdvancedFragmentListenersViewModel"/>
        <import type="com.alcanl.cleverear.di.module.ConfigurationModule"/>
        <import type="com.alcanl.cleverear.util.EarSide"/>
        <import type="android.view.View"/>
        <variable name="viewModel" type="com.alcanl.cleverear.viewmodel.AdvancedFragmentListenersViewModel" />
        <variable name="config" type="ConfigurationModule" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/main_logo_description_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/eartechnic_logo" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayoutMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"
                app:layout_constraintBottom_toTopOf="@+id/groupBoxLayoutAux"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frameLayoutDescription">

                <TextView
                    android:id="@+id/textViewMode"
                    android:layout_width="80dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/textview_mode_text"
                    android:textColor="#128ba6"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TextContrastCheck,TextSizeCheck" />

                <TextView
                    android:id="@+id/textViewChannel"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/textview_channel_text"
                    android:textColor="#128ba6"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textViewMode"
                    tools:ignore="TextContrastCheck,TextSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModeOne"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:backgroundTint="@color/default_button_color"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:onClick="@{(v)-> viewModel.handleModeButtons(v)}"
                    android:padding="0dp"
                    android:text="@string/button_text_one"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    app:cornerRadius="0dp"
                    app:layout_constraintStart_toEndOf="@+id/textViewMode"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TouchTargetSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModeTwo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="3dp"
                    android:backgroundTint="@color/default_button_color"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:onClick="@{(v)-> viewModel.handleModeButtons(v)}"
                    android:padding="0dp"
                    android:text="@string/button_text_two"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    app:cornerRadius="0dp"
                    app:layout_constraintStart_toEndOf="@+id/buttonModeOne"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TouchTargetSizeCheck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModeThree"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="3dp"
                    android:backgroundTint="@color/default_button_color"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:onClick="@{(v)-> viewModel.handleModeButtons(v)}"
                    android:padding="0dp"
                    android:text="@string/button_text_three"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    app:cornerRadius="0dp"
                    app:layout_constraintStart_toEndOf="@+id/buttonModeTwo"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TouchTargetSizeCheck" />

                <ImageButton
                    android:id="@+id/imageButton"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="15dp"
                    android:backgroundTint="#00FFFFFF"
                    android:contentDescription="@string/button_check_tick_content_desc"
                    android:onClick="@{(v)-> viewModel.handleSetChannelButtonClick(v)}"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/outlinedTextField"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/check_tick"
                    tools:ignore="ImageContrastCheck,TouchTargetSizeCheck,VisualLintBounds" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/outlinedTextField"
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="45dp"
                    android:textAlignment="center"
                    android:textColorHint="@color/ap_gray"
                    app:boxBackgroundColor="@color/off_white"
                    app:boxStrokeColor="@color/text_layout_box_color"
                    app:layout_constraintStart_toEndOf="@+id/textViewChannel"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextChannel"
                        android:layout_width="126dp"
                        android:layout_height="35dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:hint="@string/edittext_channel_hint"
                        android:inputType="number"
                        android:maxLength="3"
                        android:padding="0dp"
                        android:textAlignment="center"
                        android:textColor="@color/ap_black"
                        android:textSize="11sp"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ir.programmerplus.groupbox.GroupBoxLayout
                android:id="@+id/groupBoxLayoutAux"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:padding="5dp"
                app:borderColor="#128ba6"
                app:labelText="@string/title_aux_label"
                app:labelTextColor="#128ba6"
                app:labelTextSize="22sp"
                app:layout_constraintBottom_toTopOf="@+id/groupBoxLayoutMic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayoutMode">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout6"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    tools:layout_editor_absoluteX="231dp"
                    tools:layout_editor_absoluteY="140dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderAuxCommon"
                        android:layout_width="185dp"
                        android:layout_height="59dp"
                        android:contentDescription="@string/aux_common_slider_desc"
                        android:rotation="270"
                        android:value="@{config.INSTANCE.doubleDeviceConnection ? config.hearingAidMap.get(EarSide.Left).component13() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component13()}"
                        android:valueFrom="0.0"
                        android:valueTo="100.0"
                        android:visibility="visible"
                        app:haloColor="@color/design_default_color_secondary_variant"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.497"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:onValueChangeListener="@{(value) -> viewModel.handleAuxDualSliderValueChange(value)}"
                        app:thumbColor="@color/design_default_color_secondary_variant"
                        app:thumbRadius="16dp"
                        app:trackColorActive="@color/design_default_color_secondary_variant"
                        app:trackColorInactive="#A8A3A3"
                        app:trackHeight="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderAuxRight"
                        android:layout_width="180dp"
                        android:layout_height="59dp"
                        android:contentDescription="@string/aux_right_slider_desc"
                        android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                        android:rotation="270"
                        android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Right).component13() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component13()}"
                        android:valueFrom="0.0"
                        android:valueTo="100.0"
                        android:visibility="visible"
                        app:haloColor="@color/right_device_slider"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:onValueChangeListener="@{(value) -> viewModel.handleAuxRightSliderValueChange(value)}"
                        app:thumbColor="@color/right_device_slider"
                        app:thumbRadius="16dp"
                        app:trackColorActive="@color/right_device_slider"
                        app:trackColorInactive="#A8A3A3"
                        app:trackHeight="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderAuxLeft"
                        android:layout_width="180dp"
                        android:layout_height="59dp"
                        android:contentDescription="@string/aux_left_slider_desc"
                        android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                        android:rotation="270"
                        android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Left).component13() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component13()}"
                        android:valueFrom="0.0"
                        android:valueTo="100.0"
                        android:visibility="visible"
                        app:haloColor="@color/left_device_slider"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:onValueChangeListener="@{(value) -> viewModel.handleAuxLeftSliderValueChange(value)}"
                        app:thumbColor="@color/left_device_slider"
                        app:thumbRadius="16dp"
                        app:trackColorActive="@color/left_device_slider"
                        app:trackColorInactive="#A8A3A3"
                        app:trackHeight="12dp" />

                    <TextView
                        android:id="@+id/textViewAuxL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="57dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/textview_L_text"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textViewAuxR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="57dp"
                        android:layout_marginEnd="32dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/textview_R_text"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </ir.programmerplus.groupbox.GroupBoxLayout>

            <ir.programmerplus.groupbox.GroupBoxLayout
                android:id="@+id/groupBoxLayoutMic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:padding="5dp"
                app:borderColor="#128ba6"
                app:labelText="@string/title_mic_label"
                app:labelTextColor="#128ba6"
                app:labelTextSize="22sp"
                app:layout_constraintBottom_toTopOf="@+id/constraintLayoutDualConfig"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/groupBoxLayoutAux">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout5"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    tools:layout_editor_absoluteX="134dp"
                    tools:layout_editor_absoluteY="377dp">

                    <TextView
                        android:id="@+id/textViewMicR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="57dp"
                        android:layout_marginEnd="32dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/textview_R_text"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="VisualLintOverlap" />

                    <TextView
                        android:id="@+id/textViewMicL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="57dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/textview_L_text"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="VisualLintOverlap" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMicLeft"
                        android:layout_width="180dp"
                        android:layout_height="59dp"
                        android:contentDescription="@string/mic_left_slider_desc"
                        android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                        android:rotation="270"
                        android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Left).component14() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component14()}"
                        android:valueFrom="8.0"
                        android:valueTo="88.0"
                        android:visibility="visible"
                        app:haloColor="@color/left_device_slider"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:onValueChangeListener="@{(value) -> viewModel.handleMicLeftSliderValueChange(value)}"
                        app:thumbColor="@color/left_device_slider"
                        app:thumbRadius="16dp"
                        app:trackColorActive="@color/left_device_slider"
                        app:trackColorInactive="#A8A3A3"
                        app:trackHeight="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMicCommon"
                        android:layout_width="185dp"
                        android:layout_height="59dp"
                        android:contentDescription="@string/mic_common_slider_desc"
                        android:rotation="270"
                        android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Left).component14() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component14()}"
                        android:valueFrom="8.0"
                        android:valueTo="88.0"
                        android:visibility="visible"
                        app:haloColor="@color/design_default_color_secondary_variant"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/sliderMicRight"
                        app:layout_constraintHorizontal_bias="0.497"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:onValueChangeListener="@{(value) -> viewModel.handleMicDualSliderValueChange(value)}"
                        app:thumbColor="@color/design_default_color_secondary_variant"
                        app:thumbRadius="16dp"
                        app:trackColorActive="@color/design_default_color_secondary_variant"
                        app:trackColorInactive="#A8A3A3"
                        app:trackHeight="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMicRight"
                        android:layout_width="180dp"
                        android:layout_height="59dp"
                        android:contentDescription="@string/mic_right_slider_desc"
                        android:enabled="@{config.INSTANCE.doubleDeviceConnection ? true : false}"
                        android:rotation="270"
                        android:value="@{config.INSTANCE.doubleDeviceConnection ? config.INSTANCE.hearingAidMap.get(EarSide.Right).component14() : config.INSTANCE.hearingAidMap.get(config.INSTANCE.earSide).component14()}"
                        android:valueFrom="8.0"
                        android:valueTo="88.0"
                        android:visibility="visible"
                        app:haloColor="@color/right_device_slider"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:onValueChangeListener="@{(value) -> viewModel.handleMicRightSliderValueChange(value)}"
                        app:thumbColor="@color/right_device_slider"
                        app:thumbRadius="16dp"
                        app:trackColorActive="@color/right_device_slider"
                        app:trackColorInactive="#A8A3A3"
                        app:trackHeight="12dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </ir.programmerplus.groupbox.GroupBoxLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayoutDualConfig"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:visibility="@{config.INSTANCE.doubleDeviceConnection ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/groupBoxLayoutMic">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDual"
                    android:layout_width="150dp"
                    android:layout_height="0dp"
                    android:checked="@={config.INSTANCE.dualDeviceConfig}"
                    android:enabled="@{config.INSTANCE.doubleDeviceConnection}"
                    android:fontFamily="sans-serif-medium"
                    android:onCheckedChanged="@{()-> viewModel.handleSwitchCheckedChange()}"
                    android:text="@string/switch_dual_device_text"
                    android:textAlignment="center"
                    android:textColor="@color/ap_black"
                    android:textSize="12sp"
                    android:visibility="@{config.INSTANCE.doubleDeviceConnection ? View.VISIBLE : View.GONE}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.498"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color"
                    tools:ignore="TouchTargetSizeCheck" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/frameLayoutDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toTopOf="@+id/constraintLayoutMode"
                app:layout_constraintEnd_toStartOf="@+id/imageView3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textViewDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/textview_advanced_description_text"
                    android:textAlignment="center"
                    android:textColor="#128ba6"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:ignore="SmallSp,TextContrastCheck" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
