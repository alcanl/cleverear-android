<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fitting_navigations"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.alcanl.cleverear.fitting.fragment.HomeFragment"
        android:label="Home" >
        <action
            android:id="@+id/action_homeFragment_to_inSituFragment2"
            app:destination="@id/inSituFragment" />
    </fragment>
    <fragment
        android:id="@+id/inSituFragment"
        android:name="com.alcanl.cleverear.fitting.fragment.InSituFragment"
        android:label="In Situ"
        tools:layout="@layout/fragment_in_situ" >
        <action
            android:id="@+id/action_inSituFragment2_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_inSituFragment2_to_audiogramFragment"
            app:destination="@id/audiogramFragment" />
    </fragment>
    <fragment
        android:id="@+id/audiogramFragment"
        android:name="com.alcanl.cleverear.fitting.fragment.AudiogramFragment"
        android:label="Audiogram"
        tools:layout="@layout/fragment_audiogram" >
        <action
            android:id="@+id/action_audiogramFragment_to_fittingFragment"
            app:destination="@id/fittingFragment" />
        <action
            android:id="@+id/action_audiogramFragment_to_inSituFragment2"
            app:destination="@id/inSituFragment" />
    </fragment>
    <fragment
        android:id="@+id/fittingFragment"
        android:name="com.alcanl.cleverear.fitting.fragment.FittingFragment"
        android:label="Fitting"
        tools:layout="@layout/fragment_fitting" >
        <action
            android:id="@+id/action_fittingFragment_to_audiogramFragment"
            app:destination="@id/audiogramFragment" />
    </fragment>
</navigation>